{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://racetime.z1rracing.com/schemas/evidence-v1.json",
  "title": "Z1RR RaceTime immutable evidence manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "evidence_id", "environment", "started_at_utc",
    "completed_at_utc", "local_timezone", "operator", "reviewer",
    "components", "requirements", "artifacts", "commands", "attachments",
    "findings", "expires_at_utc", "result"
  ],
  "properties": {
    "schema_version": {"const": 1},
    "evidence_id": {"type": "string", "pattern": "^[A-Z0-9][A-Z0-9._-]{5,79}$"},
    "environment": {
      "enum": ["local", "integration", "qualification", "production-restricted", "production"]
    },
    "started_at_utc": {"type": "string", "format": "date-time"},
    "completed_at_utc": {"type": "string", "format": "date-time"},
    "local_timezone": {"type": "string", "pattern": "^[A-Za-z_]+(?:/[A-Za-z0-9_+.-]+)+$"},
    "operator": {"$ref": "#/$defs/role"},
    "reviewer": {"$ref": "#/$defs/role"},
    "components": {
      "type": "array", "minItems": 1,
      "items": {"$ref": "#/$defs/component"}
    },
    "requirements": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"type": "string", "pattern": "^(FR|NFR)-[A-Z]+-[0-9]{3}$"}
    },
    "artifacts": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[A-Z]{2,4}-[0-9]{3}$"}
    },
    "commands": {
      "type": "array", "minItems": 1,
      "items": {"$ref": "#/$defs/command"}
    },
    "attachments": {
      "type": "array",
      "items": {"$ref": "#/$defs/attachment"}
    },
    "findings": {
      "type": "array",
      "items": {"$ref": "#/$defs/finding"}
    },
    "expires_at_utc": {"type": ["string", "null"], "format": "date-time"},
    "result": {"enum": ["pass", "fail"]}
  },
  "$defs": {
    "role": {
      "type": "object", "additionalProperties": false, "required": ["role"],
      "properties": {"role": {"type": "string", "minLength": 3, "maxLength": 100}}
    },
    "component": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "commit", "image_digest", "dll_sha256", "config_sha256"],
      "properties": {
        "name": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{1,50}$"},
        "commit": {"type": ["string", "null"], "pattern": "^[0-9a-f]{40}$"},
        "image_digest": {"type": ["string", "null"], "pattern": "^sha256:[0-9a-f]{64}$"},
        "dll_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
        "config_sha256": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "command": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "command", "expected", "observed", "exit_code", "status", "stdout_sha256"],
      "properties": {
        "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{1,79}$"},
        "command": {"type": "string", "minLength": 1, "maxLength": 1000},
        "expected": {"type": "string", "minLength": 1, "maxLength": 1000},
        "observed": {"type": "string", "minLength": 1, "maxLength": 1000},
        "exit_code": {"type": "integer"},
        "status": {"enum": ["pass", "fail"]},
        "stdout_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    },
    "attachment": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "sha256", "redacted"],
      "properties": {
        "path": {"type": "string", "minLength": 1, "maxLength": 300},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "redacted": {"const": true}
      }
    },
    "finding": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "severity", "status", "owner", "due_date", "risk_acceptance_id"],
      "properties": {
        "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{1,79}$"},
        "severity": {"enum": ["P0", "P1", "P2", "P3"]},
        "status": {"enum": ["open", "closed", "accepted"]},
        "owner": {"type": "string", "maxLength": 100},
        "due_date": {"type": "string", "maxLength": 10},
        "risk_acceptance_id": {"type": ["string", "null"], "pattern": "^COUNCIL-[0-9]{4}-[0-9]{3,}$"}
      }
    }
  }
}
