# Copy to /etc/z1rr-racetime/backup.env, replace every REPLACE value, set
# owner root:root and mode 0600. This file contains references and public
# identifiers only. Keep Django, database, Redis, OAuth, and age private-key
# material in their dedicated root-owned files or Docker secret volume.

# OCI Object Storage. Instance Principal authentication is mandatory.
OCI_NAMESPACE=REPLACE_OCI_NAMESPACE
OCI_BUCKET=REPLACE_BACKUP_BUCKET
OCI_PREFIX=production

# age public recipient and root-owned identity file used by restore verification.
AGE_RECIPIENT=REPLACE_AGE_PUBLIC_RECIPIENT
AGE_IDENTITY_FILE=/etc/z1rr-racetime/backup-age-identity.txt
AGE_KEY_ID=z1rr-racetime-backup-v1

# Root-owned bounded local work areas.
BACKUP_SCRATCH_ROOT=/var/lib/z1rr-racetime/backup-scratch
BACKUP_STATUS_DIR=/var/lib/z1rr-racetime/backup-status
MIN_BACKUP_FREE_KB=5242880
BACKUP_ALERT_HOOK=/usr/local/sbin/z1rr-racetime-backup-alert

# Production deployment inputs. Do not point these at qualification state.
RACETIME_COMPOSE_FILE=/opt/z1rr-racetime/deploy/compose.production.yml
RACETIME_ENV_FILE=/etc/z1rr-racetime/racetime.env
CADDY_ENV_FILE=/etc/z1rr-racetime/caddy.env
RACETIME_RELEASE_SHA=REPLACE_40_CHARACTER_GIT_SHA
RACETIME_IMAGE=ghcr.io/z1rracing/racetime:REPLACE_40_CHARACTER_GIT_SHA
RACETIME_IMAGE_DIGEST=sha256:REPLACE_ARM64_MANIFEST_DIGEST
RACETIME_MAINTENANCE_IMAGE=ghcr.io/z1rracing/racetime-maintenance:REPLACE_40_CHARACTER_GIT_SHA
RACETIME_MAINTENANCE_IMAGE_DIGEST=sha256:REPLACE_ARM64_MANIFEST_DIGEST

# Required for compose.production.yml volume-name interpolation; the
# backup unit sources only this file, so they must be repeated here.
RACETIME_STATE_GENERATION=production
CADDY_STATE_VOLUME=z1rr-racetime-production-caddy

# Explicit production volume names.
PRODUCTION_DB_VOLUME=z1rr-racetime-production-db
PRODUCTION_MEDIA_VOLUME=z1rr-racetime-production-media
PRODUCTION_SECRET_VOLUME=z1rr-racetime-production-secrets
PRODUCTION_CADDY_STATE_VOLUME=z1rr-racetime-production-caddy

# Immutable verification helpers. Replace each placeholder with a reviewed
# linux/arm64 digest for the named tag.
MARIADB_VERIFY_IMAGE=mariadb:11.4.12@sha256:REPLACE_REVIEWED_DIGEST
ARCHIVE_HELPER_IMAGE=alpine:3.22@sha256:REPLACE_REVIEWED_DIGEST
CADDY_IMAGE=caddy:2.11.4-alpine@sha256:REPLACE_REVIEWED_DIGEST
DB_SCHEMA_NAME=racetime

# Quarterly drill inputs. After each retention run, select three verified
# production manifests from one release SHA and record that selection.
RESTORE_DATABASE_MANIFEST=production/database/REPLACE.manifest.json
RESTORE_MEDIA_MANIFEST=production/media/REPLACE.manifest.json
RESTORE_CADDY_MANIFEST=production/production-caddy-state/REPLACE.manifest.json

# Optional command override for hosts whose Python 3 executable differs.
PYTHON_BIN=python3
