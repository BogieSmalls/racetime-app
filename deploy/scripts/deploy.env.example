# Copy to /etc/z1rr-racetime/deploy.env, replace every REPLACE value, and set
# owner root:root and mode 0600. Never place passwords, tokens, or webhooks here.
Z1RR_DEPLOY_STATE_DIR=/var/lib/z1rr-racetime/deploy
Z1RR_BACKUP_STATUS_DIR=/var/lib/z1rr-racetime/backup-status
Z1RR_COMPOSE_FILE=/opt/z1rr-racetime/deploy/compose.production.yml
Z1RR_PREFLIGHT_SCRIPT=/opt/z1rr-racetime/deploy/scripts/preflight.sh
Z1RR_BACKUP_SCRIPT=/opt/z1rr-racetime/deploy/backup/backup.sh
Z1RR_SMOKE_SCRIPT=/opt/z1rr-racetime/deploy/scripts/smoke.py

Z1RR_APP_IMAGE_REPOSITORY=ghcr.io/z1rracing/racetime
Z1RR_MAINTENANCE_IMAGE_REPOSITORY=ghcr.io/z1rracing/racetime-maintenance
Z1RR_COSIGN_IDENTITY_REGEXP=https://github.com/z1rracing/racetime/.github/workflows/release.yml@refs/heads/main
Z1RR_COSIGN_OIDC_ISSUER=https://token.actions.githubusercontent.com

Z1RR_PUBLIC_ORIGIN=https://racetime.z1rracing.com
Z1RR_SMOKE_WEBSOCKET_PATH=/ws/race/REPLACE_DEPLOY_SMOKE_RACE
Z1RR_DEPLOY_ACTOR=REPLACE_OPERATOR_HANDLE

# These Compose interpolation inputs select the exact production state. They
# are references only; secret values remain in the production secret volume.
RACETIME_ENV_FILE=/etc/z1rr-racetime/racetime.env
CADDY_ENV_FILE=/etc/z1rr-racetime/caddy.env
RACETIME_STATE_GENERATION=production
CADDY_STATE_VOLUME=z1rr-racetime-production-caddy
