{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://racetime.z1rracing.com/schemas/g0-restream-history-v1.json",
  "title": "Z1RR RaceTime metadata-only Restream history baseline",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "repository",
    "base_commit",
    "candidate_commit",
    "captured_at_utc",
    "findings"
  ],
  "properties": {
    "schema_version": {"type": "string", "const": "1"},
    "repository": {"const": "restream"},
    "base_commit": {"$ref": "#/$defs/commit"},
    "candidate_commit": {"$ref": "#/$defs/commit"},
    "captured_at_utc": {"$ref": "#/$defs/utc_timestamp"},
    "findings": {
      "type": "array",
      "items": {"$ref": "#/$defs/finding"}
    }
  },
  "$defs": {
    "commit": {
      "type": "string",
      "pattern": "^[0-9a-f]{40}$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "utc_timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?Z$"
    },
    "relative_path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255,
      "pattern": "^(?![\\s\\S]*[\\r\\n])(?!/)(?!~)(?!.*(?:^|/)\\.\\.?(?:/|$))(?!.*//)(?!.*\\\\)(?!.*:)[A-Za-z0-9][A-Za-z0-9._/-]*$"
    },
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rule_id",
        "path",
        "source_commit",
        "line",
        "fingerprint_sha256",
        "classification",
        "outside_candidate",
        "live_credential_disposition",
        "evidence_id"
      ],
      "properties": {
        "rule_id": {"$ref": "#/$defs/identifier"},
        "path": {"$ref": "#/$defs/relative_path"},
        "source_commit": {"$ref": "#/$defs/commit"},
        "line": {"type": "integer", "minimum": 1, "maximum": 2147483647},
        "fingerprint_sha256": {"$ref": "#/$defs/sha256"},
        "classification": {"enum": ["inactive-history", "test-fixture"]},
        "outside_candidate": {"const": true},
        "live_credential_disposition": {
          "enum": ["not-a-credential", "revoked", "rotated"]
        },
        "evidence_id": {"$ref": "#/$defs/identifier"}
      }
    }
  }
}
