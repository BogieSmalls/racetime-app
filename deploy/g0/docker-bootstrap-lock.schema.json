{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://racetime.z1rracing.com/schemas/g0-docker-bootstrap-lock-v1.json",
  "title": "Z1RR RaceTime OCI G0 Docker bootstrap lock",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "generated_at_utc",
    "host",
    "signing_key",
    "repository",
    "packages",
    "allowed_package_delta",
    "bootstrap_tools"
  ],
  "properties": {
    "schema_version": {"type": "string", "const": "1"},
    "generated_at_utc": {"$ref": "#/$defs/utc_timestamp"},
    "host": {
      "type": "object",
      "additionalProperties": false,
      "required": ["distribution", "release", "architecture"],
      "properties": {
        "distribution": {"const": "ubuntu"},
        "release": {"const": "24.04"},
        "architecture": {"const": "arm64"}
      }
    },
    "signing_key": {
      "type": "object",
      "additionalProperties": false,
      "required": ["url", "sha256", "fingerprint"],
      "properties": {
        "url": {"$ref": "#/$defs/https_url"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "fingerprint": {
          "type": "string",
          "pattern": "^[0-9A-F]{40}$"
        }
      }
    },
    "repository": {
      "type": "object",
      "additionalProperties": false,
      "required": ["definition", "inrelease_url", "inrelease_sha256"],
      "properties": {
        "definition": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1024,
          "pattern": "^(?![\\s\\S]*[\\r\\n]).+$"
        },
        "inrelease_url": {"$ref": "#/$defs/https_url"},
        "inrelease_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "packages": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/package"}
    },
    "allowed_package_delta": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/identifier"}
    },
    "bootstrap_tools": {
      "type": "object",
      "additionalProperties": false,
      "required": ["buildx", "buildkit", "runtime_probe"],
      "properties": {
        "buildx": {"$ref": "#/$defs/binary"},
        "buildkit": {"$ref": "#/$defs/image"},
        "runtime_probe": {"$ref": "#/$defs/image"}
      }
    }
  },
  "$defs": {
    "utc_timestamp": {
      "type": "string",
      "format": "date-time",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(?:\\.[0-9]+)?Z$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "https_url": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://(?![\\s\\S]*[\\s\\x00-\\x1F\\x7F\\u0080-\\u009F])(?:\\[[0-9A-Fa-f:.]+\\]|[A-Za-z0-9](?:[A-Za-z0-9.-]*[A-Za-z0-9])?)(?::(?:[1-9][0-9]{0,3}|[1-5][0-9]{4}|6[0-4][0-9]{3}|65[0-4][0-9]{2}|655[0-2][0-9]|6553[0-5]))?(?:/[^\\s\\x00-\\x1F\\x7F\\u0080-\\u009F]*)?$",
      "maxLength": 2048
    },
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
    },
    "relative_path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 255,
      "pattern": "^(?![\\s\\S]*[\\r\\n])(?!/)(?!~)(?!.*(?:^|/)\\.\\.?(?:/|$))(?!.*//)(?!.*\\\\)(?!.*:)[A-Za-z0-9][A-Za-z0-9._/-]*$"
    },
    "package": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "version", "architecture", "origin", "url", "sha256"],
      "properties": {
        "name": {"$ref": "#/$defs/identifier"},
        "version": {"type": "string", "minLength": 1, "maxLength": 255},
        "architecture": {"const": "arm64"},
        "origin": {"type": "string", "minLength": 1, "maxLength": 255},
        "url": {"$ref": "#/$defs/https_url"},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "binary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "kind", "version", "url", "sha256", "executable_path"],
      "properties": {
        "name": {"$ref": "#/$defs/identifier"},
        "kind": {"const": "binary"},
        "version": {"$ref": "#/$defs/identifier"},
        "url": {"$ref": "#/$defs/https_url"},
        "sha256": {"$ref": "#/$defs/sha256"},
        "executable_path": {"$ref": "#/$defs/relative_path"}
      }
    },
    "platform": {
      "type": "object",
      "additionalProperties": false,
      "required": ["platform", "digest"],
      "properties": {
        "platform": {"enum": ["linux/amd64", "linux/arm64"]},
        "digest": {"$ref": "#/$defs/sha256"}
      }
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "kind", "version", "reference", "index_digest", "platforms"],
      "properties": {
        "name": {"$ref": "#/$defs/identifier"},
        "kind": {"const": "image"},
        "version": {"$ref": "#/$defs/identifier"},
        "reference": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._/-]*(?::[A-Za-z0-9][A-Za-z0-9._-]*)?@sha256:[0-9a-f]{64}$",
          "maxLength": 512
        },
        "index_digest": {"$ref": "#/$defs/sha256"},
        "platforms": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/platform"}
        }
      }
    }
  }
}
