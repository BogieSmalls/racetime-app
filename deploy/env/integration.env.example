# Fixed, non-production values for the isolated local integration stack.
DJANGO_SETTINGS_MODULE=project.settings.integration
DJANGO_SECRET_KEY=integration-only-django-secret-key-never-use-in-production
RACETIME_INTEGRATION_ORIGIN=https://integration.racetime.test:8443
RACETIME_CI_DB_NAME=racetime_integration
RACETIME_CI_DB_USER=racetime_integration
RACETIME_CI_DB_PASSWORD=integration-db-password
RACETIME_CI_DB_HOST=db
RACETIME_CI_DB_PORT=3306
RACETIME_CI_REDIS_URL=redis://:integration-redis-password@redis:6379/15
RACETIME_CI_THROTTLE_HMAC_KEY=integration-only-throttle-hmac-key-0123456789abcdef
DISCORD_CLIENT_ID=fixture-discord-client
DISCORD_CLIENT_SECRET=fixture-discord-client-secret-never-production
TWITCH_CLIENT_ID=fixture-twitch-client
TWITCH_CLIENT_SECRET=fixture-twitch-client-secret-never-production
FIXTURE_DISCORD_CLIENT_ID=fixture-discord-client
FIXTURE_DISCORD_CLIENT_SECRET=fixture-discord-client-secret-never-production
FIXTURE_DISCORD_REDIRECT_URI=https://integration.racetime.test:8443/account/discord/callback
MARIADB_DATABASE=racetime_integration
MARIADB_USER=racetime_integration
MARIADB_PASSWORD=integration-db-password
MARIADB_ROOT_PASSWORD=integration-root-password
REDIS_PASSWORD=integration-redis-password

