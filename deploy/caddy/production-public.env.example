# Example for G3 public access. The ACME issuer and state volume do not change.
CADDY_SITE_HOST=raceroom.z1rracing.com
CADDY_ALIAS_HOST=racetime.z1rracing.com
CADDY_ACME_EMAIL=operator@example.invalid
CADDY_ACME_CA=https://acme-v02.api.letsencrypt.org/directory
CADDY_ACME_TEST_CA=https://acme-v02.api.letsencrypt.org/directory
CADDY_ACCESS_PHASE=public
CADDY_ALLOWED_CIDRS=0.0.0.0/0 ::/0
CADDY_HSTS_VALUE=max-age=31536000
